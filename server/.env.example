# Copy to server/.env and fill in.

# Local MongoDB:      mongodb://127.0.0.1:27017/overall360
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/overall360
MONGODB_URI=mongodb://127.0.0.1:27017/overall360
PORT=5000
# Comma-separated list of allowed frontend origins in production (optional)
# CLIENT_ORIGIN=https://your-frontend.example.com

# true = throwaway in-memory MongoDB for quick trials (no install needed)
USE_MEMORY_DB=false

# Signs sign-in sessions (JWT). Use a long random value and keep it private:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# How long a sign-in lasts (optional)
# JWT_EXPIRES_IN=7d

# Demo accounts created on startup if missing (one email per role, RBAC):
#   superadmin@transcendgroup.org  → Super Admin  → /admin
#   admin@transcendgroup.org       → Admin        → /admin
#   professor@transcendgroup.org   → Professor    → /professor/dashboard
#   student@transcendgroup.org     → Student      → /student/dashboard
#   seeded alumni emails (e.g. priya@goldman.com) → Alumni → /alumni/dashboard
# All of them use SEED_DEMO_PASSWORD.
SEED_DEMO_PASSWORD=choose-a-demo-password
